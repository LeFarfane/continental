# Copia este archivo a `.env` y llénalo. `.env` está en .gitignore.
#
# Continental no tiene cuenta en ningún sitio de terceros: las sesiones de
# proveedor viven en Doyle y nunca pasan por aquí. Lo que hay es a dónde
# escribir y a quién preguntarle.

# -----------------------------------------------------------------------------
# El almacén de farmacia-data. LA MISMA base a la que apunta dbt.
# -----------------------------------------------------------------------------
# Con un rol `continental` que solo pueda:
#   INSERT, UPDATE, DELETE, SELECT  sobre sus propias tablas (pedidos, renglones)
#   SELECT                          sobre marts.fct_ventas, marts.dim_producto,
#                                   marts.dim_fecha, marts.fct_compras,
#                                   marts.dim_proveedor
#
# Ese permiso es la garantía, igual que el usuario `lector` de MySQL en
# farmacia-data. Las reglas escritas en CLAUDE.md son un cinturón adicional.
WAREHOUSE_URL=postgresql+psycopg2://continental:CAMBIAME@localhost:5432/farmacia

# -----------------------------------------------------------------------------
# EXACTAMENTE el mismo código que farmacia-data/config/farmacia.yml, clave
# `codigo` (hoy: farmacia_01, NO "farmacia" a secas).
# -----------------------------------------------------------------------------
# TRAMPA YA VIVIDA por Marlowe el 2026-09-05: con el valor equivocado, un join
# contra los datos de farmacia-data no encuentra NADA y la tabla sale vacía
# sin ningún error -parece una corrida exitosa-. Verifica el valor real, no
# asumas.
CODIGO_NEGOCIO=farmacia_01

# -----------------------------------------------------------------------------
# Dónde escucha Continental
# -----------------------------------------------------------------------------
# En la torre, `127.0.0.1` y listo. En atlas hace falta el gateway de la red
# Docker `borde`, porque para el contenedor del túnel `localhost` es él mismo y
# no el host -Marlowe lo midió como un 502 el 2026-09-06-. Verifícalo con
# `docker network inspect borde`: si se recrea la red, ese gateway cambia.
# CONTINENTAL_HOST=172.19.0.1

# -----------------------------------------------------------------------------
# Latido a Uptime Kuma cuando el lote nocturno de precios termina bien.
# -----------------------------------------------------------------------------
# Un monitor APARTE de los de farmacia-data y Marlowe: si compartieran monitor,
# una noche sin lote no avisaría nada -la cadena de ventas seguiría latiendo- y
# el silencio, que es el modo de falla que de verdad muerde, pasaría
# inadvertido. Si falla el latido NO se aborta: marcar como rota una corrida
# buena es peor que perderse un latido.
# KUMA_PUSH_URL_CONTINENTAL=
